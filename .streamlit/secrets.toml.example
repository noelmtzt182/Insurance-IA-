# =====================================================================
# Plantilla de secretos para Insurance Leads AI
#
# Cómo usarla:
#   - En tu computadora: copia este archivo como .streamlit/secrets.toml
#     y llena los valores.
#   - En Streamlit Cloud: pega el contenido en
#     Settings → Secrets de tu app.
#
# NUNCA subas el archivo secrets.toml con valores reales a Git.
# Las líneas que empiezan con # están desactivadas: quita el # para usarlas.
# =====================================================================

# Token que se pide al crear el primer usuario administrador.
SETUP_TOKEN = "cambia-este-token"

# --- Administrador inicial (opcional) ---
# El hash se genera con:  python -m services.auth "Contraseña"
# [auth]
# admin_username = "admin"
# admin_password_hash = "pega-aqui-el-hash"

# --- Base de datos PostgreSQL (opcional; sin esto se usa SQLite local) ---
# [database]
# url = "postgresql+psycopg2://usuario:clave@host:5432/insurance_leads?sslmode=require"

# --- Inteligencia artificial con Anthropic (opcional) ---
# ANTHROPIC_API_KEY = "sk-ant-..."
# ANTHROPIC_MODEL = "claude-opus-5-5"

# --- Google Ads (opcional) ---
# [google_ads]
# developer_token = "..."
# client_id = "..."
# client_secret = "..."
# refresh_token = "..."
# login_customer_id = "1234567890"
# customer_id = "1234567890"
# lead_form_key = "..."

# --- Meta Lead Ads (opcional) ---
# [meta]
# access_token = "..."
# graph_version = "v21.0"
# form_ids = ["1234567890"]

# --- Google Trends (opcional) ---
# [google_trends]
# endpoint = "https://..."
# api_key = "..."

# --- WhatsApp Cloud API (opcional) ---
# [whatsapp]
# access_token = "..."
# phone_number_id = "..."
# graph_version = "v21.0"
# enabled = false
